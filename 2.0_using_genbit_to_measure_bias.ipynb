   "source": [
    "# Cleanse responses by removing unnecessary characters (e.g. \\n or [)\n",
    "def strip_characters(response):\n",
    "    \n",
    "    cleansed_response = re.sub('\\n', ' ', response)\n",
    "    cleansed_response = re.sub(\"\\\"\",'', cleansed_response)\n",
    "    cleansed_response = re.sub(\"]\",'', cleansed_response)\n",
    "    cleansed_response = re.sub(\"\\[\",'', cleansed_response)\n",
    "    \n",
    "    return cleansed_response"
   ]
